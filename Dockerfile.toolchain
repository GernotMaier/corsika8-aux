# Reusable CORSIKA8 build toolchain. Publish this image separately from
# CORSIKA itself so compiler and Python setup is shared across source refs.
FROM almalinux:9.5-minimal

ARG PYTHON_VERSION="3.12"
ARG CORSIKA_REF="master"
WORKDIR /workdir/

RUN microdnf update -y && \
    microdnf install -y \
    binutils cmake findutils \
    curl gcc-c++ gcc-gfortran git make \
    perl perl-core \
    python${PYTHON_VERSION} python${PYTHON_VERSION}-pip \
    python${PYTHON_VERSION}-devel rsync tar vim && \
    microdnf clean all && \
    ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python && \
    ln -sf /usr/bin/pip${PYTHON_VERSION} /usr/bin/pip && \
    python -m venv /workdir/virtual/environment/corsika-8 && \
    . /workdir/virtual/environment/corsika-8/bin/activate && \
    python -m pip install --upgrade pip --root-user-action=ignore && \
    python -m pip install "conan>=2.20.0" numpy==2.3 particle==0.25.1

ENV VIRTUAL_ENV=/workdir/virtual/environment/corsika-8
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
# Keep Conan's package cache at a stable, mountable location for code builds.
ENV CONAN_HOME=/root/.conan2

# A CORSIKA source checkout is intentionally not part of this image.  The
# recipe is sufficient for Conan to populate its package cache and generate
# the CMake files consumed by the later source build.  Fetching this one file
# avoids a second clone of the (recursive) CORSIKA repository.
RUN curl --fail --location --retry 5 --silent --show-error \
      "https://gitlab.iap.kit.edu/AirShowerPhysics/corsika/-/raw/${CORSIKA_REF}/conanfile.py" \
      --output /workdir/conanfile.py && \
    conan profile detect --force --name corsika8 && \
    sed -i \
      -e 's/^compiler\.cppstd=.*/compiler.cppstd=gnu17/' \
      -e 's/^compiler\.libcxx=.*/compiler.libcxx=libstdc++11/' \
      "$CONAN_HOME/profiles/corsika8" && \
    conan install /workdir \
      --output-folder=/workdir/corsika-conan \
      --build=missing \
      --settings=build_type=Release \
      --profile=corsika8 && \
    rm -f /workdir/conanfile.py && \
    conan cache clean '*' --source --build --download
